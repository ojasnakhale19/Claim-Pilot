# ClaimPilot AI Backend Environment Configuration
# Copy this file to .env and fill in your values

# ============================================
# Model Configuration
# ============================================
# Local path to custom trained model (optional - defaults to backend/models/best.pt)
AUTOSETTLE_MODEL_PATH=

# HuggingFace Hub fallback (used if local model not found)
AUTOSETTLE_HF_REPO=shanexf/car-damage-yolo11m-ft
AUTOSETTLE_HF_FILENAME=damage_best.pt

# ============================================
# Image Validation Thresholds
# ============================================
# Minimum image side length in pixels
AUTOSETTLE_MIN_IMAGE_SIDE=240

# Minimum Laplacian variance for blur detection (lower = more permissive)
# Phone photos in normal lighting: 10-15. Studio/high-quality: 18+.
AUTOSETTLE_MIN_LAPLACIAN_VARIANCE=10

# Hamming distance threshold for near-duplicate detection
AUTOSETTLE_NEAR_DUPLICATE_DISTANCE=3

# Confidence threshold below which detections are flagged for review
AUTOSETTLE_LOW_CONFIDENCE_THRESHOLD=0.40

# ============================================
# Hybrid AI Provider (Optional - for /assess/hybrid)
# ============================================
# Provider: "gemini" or "openai"
AI_PROVIDER=gemini

# Google Gemini API Key (get from https://aistudio.google.com/)
GEMINI_API_KEY=

# Gemini model to use
GEMINI_MODEL=gemini-1.5-flash-latest

# OpenAI API Key (get from https://platform.openai.com/)
OPENAI_API_KEY=

# OpenAI model to use
OPENAI_MODEL=gpt-4o-mini

# ============================================
# Negotiation Engine (Optional)
# ============================================
# OpenAI API Key for negotiation (can reuse OPENAI_API_KEY)
NEGOTIATION_OPENAI_API_KEY=

# ============================================
# Server Configuration
# ============================================
# Backend server host (0.0.0.0 for all interfaces)
HOST=0.0.0.0

# Backend server port
PORT=8000

# Frontend URL for CORS (comma-separated for multiple)
FRONTEND_URL=http://localhost:5173

# ============================================
# Logging
# ============================================
LOG_LEVEL=INFO