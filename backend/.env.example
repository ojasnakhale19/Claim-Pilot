# ClaimPilot AI Backend Configuration
# Copy this file to .env and modify as needed

# Model Configuration
# Option 1: Use local model weights (recommended for production)
# AUTOSETTLE_MODEL_PATH=/absolute/path/to/your/damage_best.pt

# Option 2: Use Hugging Face model (default)
AUTOSETTLE_HF_REPO=shanexf/car-damage-yolo11m-ft
AUTOSETTLE_HF_FILENAME=damage_best.pt

# Validation Thresholds (optional - defaults shown)
AUTOSETTLE_MIN_IMAGE_SIDE=240
AUTOSETTLE_MIN_LAPLACIAN_VARIANCE=18
AUTOSETTLE_NEAR_DUPLICATE_DISTANCE=3
AUTOSETTLE_LOW_CONFIDENCE_THRESHOLD=0.40

# Hybrid AI Configuration (for multimodal vision/LLM reasoning)
# Set AI_PROVIDER to "gemini" or "openai"
AI_PROVIDER=gemini

# Gemini Configuration (get key from https://makersuite.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash-latest

# OpenAI Configuration (get key from https://platform.openai.com/api-keys)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Server Configuration
HOST=0.0.0.0
PORT=8000