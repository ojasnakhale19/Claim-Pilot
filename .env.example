# ClaimPilot AI Environment Configuration
# Copy this file to .env and fill in your values

# ─── AI Provider Configuration ───────────────────────────────────────────────
# Set to "gemini" or "openai" to enable Hybrid AI assessment
# If not set, only local YOLO inference will be available
AI_PROVIDER=gemini

# Google Gemini API Key (get from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Google Gemini Model (gemini-1.5-flash-latest, gemini-1.5-pro-latest, etc.)
GEMINI_MODEL=gemini-1.5-flash-latest

# OpenAI API Key (get from https://platform.openai.com/api-keys)
OPENAI_API_KEY=your_openai_api_key_here

# OpenAI Model (gpt-4o-mini, gpt-4o, gpt-4-turbo, etc.)
OPENAI_MODEL=gpt-4o-mini

# ─── Model Configuration ─────────────────────────────────────────────────────
# Path to local YOLO model (best.pt or best.onnx)
# Default: backend/models/best.pt
AUTOSETTLE_MODEL_PATH=backend/models/best.pt

# Hugging Face fallback (if local model not found)
AUTOSETTLE_HF_REPO=shanexf/car-damage-yolo11m-ft
AUTOSETTLE_HF_FILENAME=damage_best.pt

# ─── Inference Thresholds ────────────────────────────────────────────────────
# Confidence threshold for YOLO detections (0.0-1.0)
AUTOSETTLE_LOW_CONFIDENCE_THRESHOLD=0.40

# Confidence threshold for assessment (0.0-1.0)
# Used in damage_assessment.py and main.py
CONFIDENCE_THRESHOLD=0.25

# ─── Image Quality Thresholds ────────────────────────────────────────────────
# Minimum image side in pixels
AUTOSETTLE_MIN_IMAGE_SIDE=240

# Minimum Laplacian variance for blur detection
AUTOSETTLE_MIN_LAPLACIAN_VARIANCE=18

# Near duplicate Hamming distance threshold
AUTOSETTLE_NEAR_DUPLICATE_DISTANCE=3

# ─── Server Configuration ────────────────────────────────────────────────────
# Backend server host and port
HOST=0.0.0.0
PORT=8000

# Frontend dev server port (Vite)
VITE_PORT=5173

# ─── CORS Origins ────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,*