# ClaimPilot AI Frontend Environment Configuration
# Copy this file to .env and fill in your values

# ============================================
# API Configuration
# ============================================
# Backend API URL (must include protocol and port)
VITE_API_URL=http://localhost:8000

# ============================================
# Feature Flags
# ============================================
# Enable demo mode (simulated assessments)
VITE_DEMO_MODE=true

# Enable local AI inference (requires ONNX model in public/)
VITE_LOCAL_AI_ENABLED=true

# Enable hybrid AI assessment (requires backend AI provider configured)
VITE_HYBRID_AI_ENABLED=false

# ============================================
# Model Configuration
# ============================================
# Path to ONNX model for browser inference (relative to public/)
VITE_YOLO_MODEL_PATH=/best.onnx

# Confidence threshold for local inference
VITE_CONFIDENCE_THRESHOLD=0.25

# ============================================
# UI Configuration
# ============================================
# Default assessment mode: 'demo' | 'ai' | 'video-four-view'
VITE_DEFAULT_ASSESSMENT_MODE=ai